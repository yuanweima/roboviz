{
  "name": "@aspect/roboviz-core",
  "version": "0.1.0",
  "description": "Core rendering engine for RoboViz",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./rendering": {
      "types": "./dist/rendering-entry.d.ts",
      "import": "./dist/rendering-entry.mjs",
      "require": "./dist/rendering-entry.js"
    },
    "./kinematics": {
      "types": "./dist/kinematics-entry.d.ts",
      "import": "./dist/kinematics-entry.mjs",
      "require": "./dist/kinematics-entry.js"
    },
    "./planning": {
      "types": "./dist/planning-entry.d.ts",
      "import": "./dist/planning-entry.mjs",
      "require": "./dist/planning-entry.js"
    },
    "./protocol": {
      "types": "./dist/protocol-entry.d.ts",
      "import": "./dist/protocol-entry.mjs",
      "require": "./dist/protocol-entry.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup src/index.ts --watch",
    "build": "tsup src/index.ts src/rendering-entry.ts src/kinematics-entry.ts src/planning-entry.ts src/protocol-entry.ts --format cjs,esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "trajx-wasm": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "trajx-wasm": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-three/drei": "^9.0.0",
    "@react-three/fiber": "^9.0.0",
    "@react-three/postprocessing": "^3.0.4",
    "nanoid": "^5.0.0",
    "postprocessing": "^6.38.2",
    "three": "^0.170.0",
    "urdf-loader": "^0.12.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^2.0.0",
    "trajx-wasm": "file:./vendor/trajx-wasm",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^2.0.0"
  }
}
